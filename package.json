{
  "name": "kalakart",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspace=@kalakart/shared && npm run build --workspace=api && npm run build --workspace=web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"**/*.{ts,tsx}\" --ignore-pattern dist --ignore-pattern node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "@google/genai@2.27.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
  }
}
