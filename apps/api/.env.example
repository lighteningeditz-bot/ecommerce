NODE_ENV=development
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Gemini (server-side only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Rate limiting
RATE_LIMIT_GLOBAL_PER_15MIN=300
AI_RATE_LIMIT_IP_PER_10MIN=10
AI_RATE_LIMIT_USER_PER_HOUR=20
AI_RATE_LIMIT_ADMIN_PER_HOUR=30

# Business rules (fallbacks if store_settings is unreachable)
MAX_LISTING_PRICE_INR=2500
FREE_SHIPPING_THRESHOLD_INR=499
FLAT_SHIPPING_INR=40
